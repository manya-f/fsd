{
  "name": "hackpulse",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace backend run dev",
    "dev:web": "npm --workspace frontend run dev",
    "build": "npm --workspace frontend run build",
    "start": "npm --workspace backend run start",
    "seed": "npm --workspace backend run seed",
    "test": "npm --workspace backend test"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
