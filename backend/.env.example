PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<url-encoded-password>@<your-cluster>.mongodb.net/hackpulse
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=12h
CLIENT_ORIGINS=http://localhost:5173
MANAGER_EMAIL=admin@example.com
MANAGER_PASSWORD=replace-with-a-unique-password-at-least-12-characters
MANAGER_NAME=HackPulse Admin
